<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bundle template for the native XP-Pen Deco 01 V3 driver.

  Substituted by the Makefile:
    @APP_NAME@    human-readable name, e.g. "InkDriver"
    @EXECUTABLE@  Mach-O name inside Contents/MacOS
    @BUNDLE_ID@   reverse-DNS identifier

  LSUIElement makes it a menu-bar-only application: no Dock icon and no app
  switcher entry, the same shape the vendor's XPPenTablet.app uses in "/mini"
  mode. The name is deliberately unrelated to "XP-Pen"/"XPPenTablet" so TCC
  entries and the menu bar cannot be confused with the vendor software.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>@APP_NAME@</string>
    <key>CFBundleDisplayName</key>
    <string>@APP_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>@BUNDLE_ID@</string>
    <key>CFBundleExecutable</key>
    <string>@EXECUTABLE@</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>Native replacement driver for the XP-Pen Deco 01 V3. No vendor code.</string>
</dict>
</plist>
